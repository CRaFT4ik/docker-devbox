{
  "log": { "level": "warn" },
  "dns": {
    "servers": [
      { "type": "hosts", "tag": "sys-hosts" },
      {
        "type": "tcp",
        "tag": "dns-via-proxy",
        "server": "__DNS_SERVER__",
        "server_port": 53,
        "detour": "proxy"
      }
    ],
    "rules": [
      { "domain_suffix": ["host.docker.internal"], "server": "sys-hosts" }
    ],
    "final": "dns-via-proxy"
  },
  "inbounds": [
    {
      "type": "tun",
      "tag": "tun-in",
      "address": ["172.19.0.1/30"],
      "auto_route": true,
      "strict_route": true,
      "stack": "mixed"
    }
  ],
  "outbounds": [
    { "type": "socks", "tag": "proxy", "server": "__HOSTPROXY_HOST__", "server_port": __HOSTPROXY_PORT__, "version": "5" },
    { "type": "direct", "tag": "direct" }
  ],
  "route": {
    "auto_detect_interface": true,
    "default_domain_resolver": { "server": "sys-hosts" },
    "final": "proxy",
    "rules": [
      { "action": "sniff" },
      {
        "type": "logical",
        "mode": "or",
        "rules": [ { "protocol": "dns" }, { "port": 53 } ],
        "action": "hijack-dns"
      }
    ]
  }
}
