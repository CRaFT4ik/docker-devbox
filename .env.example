# Username/UID inside the container. Matches the host UID so bind-mounted
# files are owned correctly on Linux hosts. On Windows/macOS Docker Desktop
# the mount driver ignores UIDs, so any values work.
DEV_USER=corp
DEV_UID=1000
DEV_GID=1000

# Host paths to bind-mount into the container.
# Use forward slashes on Windows (e.g. C:/Users/<you>/AndroidSDK).
HOST_ANDROID_SDK=/absolute/path/to/AndroidSDK
HOST_WORK_DIR=/absolute/path/to/workdir
HOST_GIT_CONFIG=/absolute/path/to/.gitconfig
HOST_SSH_DIR=/absolute/path/to/.ssh

# Gradle user home from the host, bind-mounted read-write so the container
# reuses the host's Gradle distribution and dependency cache (enables offline
# builds/tests without hitting the internal artifact repository).
HOST_GRADLE_HOME=/absolute/path/to/.gradle

# Egress mode (REQUIRED). One of:
#   singbox   - sing-box TUN using your Remnawave VLESS+Reality subscription (SUB_URL)
#   hostproxy - tunnel all traffic into a SOCKS5 proxy on the host (HOSTPROXY_PORT)
#   wireguard - bring up ./wireguard/*.conf (the previous default behaviour)
VPN_MODE=singbox

# singbox mode: your Remnawave subscription URL (the panel returns sing-box JSON).
SUB_URL=

# hostproxy mode: the port of your host's own SOCKS5 proxy that the container
# dials via host.docker.internal (container -> host). This is the UPSTREAM the
# container sends traffic to. Not to be confused with SOCKS_PUBLISH_PORT below.
HOSTPROXY_PORT=

# wireguard mode: place your WireGuard config(s) in ./wireguard/*.conf.
# The filename (minus .conf) becomes the interface name (letters, digits,
# '-', '_'; max 15 chars). MIGRATION: move an existing wg-peer9.conf into
# ./wireguard/ and remove the old WG_CONFIG variable.

# Port on the host where the container PUBLISHES its own danted SOCKS5
# (host -> container, all modes): 127.0.0.1:${SOCKS_PUBLISH_PORT} -> :1080.
# Point your browser / apps at 127.0.0.1:${SOCKS_PUBLISH_PORT} to tunnel through
# the container's VPN. Inside the container danted always listens on 1080.
SOCKS_PUBLISH_PORT=1080
